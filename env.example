# =====================================================================
# Nutri-IA — Variables de entorno
# Copia este archivo como ".env" (local) o pega cada variable en
# Railway → tu servicio → pestaña "Variables". NUNCA subas .env a GitHub.
# =====================================================================

# ----- EMPRESA (aviso de privacidad y CFDI) -----
COMPANY_LEGAL_NAME=
COMPANY_RFC=
COMPANY_TAX_REGIME=            # Clave SAT del régimen fiscal (ej. 601)
COMPANY_ZIP_CODE=              # CP del domicilio fiscal
PRIVACY_NOTICE_URL=            # URL pública del Aviso de Privacidad
SUPPORT_EMAIL=

# ----- APLICACIÓN -----
APP_ENV=                       # development | production
PSEUDONYM_PEPPER=              # Generar con: python crypto.py
FIELD_ENCRYPTION_KEY=          # Generar con: python crypto.py  (¡RESPALDAR!)
ADMIN_API_TOKEN=               # Generar con: python crypto.py
DISCLAIMER_VERSION=            # Ej. v1.0 — súbela cada vez que cambies un aviso
DATABASE_URL=                  # Railway → PostgreSQL → Variables → DATABASE_URL

# ----- WHATSAPP CLOUD API (Meta) -----
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=               # Texto que tú inventas; el mismo va en Meta
WA_APP_SECRET=
WA_API_VERSION=                # Ej. v21.0
WA_TEMPLATE_CHECKIN_ES=        # Nombre de la plantilla aprobada (español)
WA_TEMPLATE_CHECKIN_EN=        # Nombre de la plantilla aprobada (inglés)
WA_TEMPLATE_LANG_ES=           # Código de idioma de la plantilla (ej. es_MX)
WA_TEMPLATE_LANG_EN=           # Código de idioma de la plantilla (ej. en_US)

# ----- STRIPE -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GUIDE_MXN=        # price_... de $299 MXN (pago único)
STRIPE_PRICE_GUIDE_USD=        # price_... equivalente en USD (pago único)
STRIPE_PRICE_PRO_MXN=          # price_... de $999 MXN/mes (solo Canal 2)
STRIPE_PRICE_PRO_USD=          # price_... equivalente USD/mes (solo Canal 2)
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
GUIDE_PRICE_LABEL_ES=          # Texto que ve el usuario, ej. $299 MXN
GUIDE_PRICE_LABEL_EN=          # Ej. $17 USD
PRO_PRICE_LABEL_ES=            # Ej. $999 MXN
PRO_PRICE_LABEL_EN=            # Ej. $55 USD

# ----- FACTURACIÓN CFDI 4.0 (PAC) — opcional en fase 1 -----
PAC_PROVIDER=
PAC_API_KEY=
PAC_SANDBOX=                   # true | false

# ----- FEATURE FLAGS -----
FF_B2B_CHANNEL_ENABLED=        # true | false  (vacío = false)
FF_B2B_AUTO_ENABLE_AT_SALES=   # Ej. 10000 — vacío = solo encendido manual
FF_CEDULA_AUTO_VALIDATION=     # true | false  (vacío = false)

# ----- REGLAS DE NEGOCIO Y SEGURIDAD -----
MIN_USER_AGE=                  # Mínimo permitido: 18
MAX_USER_AGE=                  # Ej. 65
MIN_DAILY_KCAL_FEMALE=         # Piso calórico de seguridad (ej. 1200)
MIN_DAILY_KCAL_MALE=           # Piso calórico de seguridad (ej. 1500)
FOLLOWUP_WEEKS=                # Semanas de check-in incluidas en el pago único
